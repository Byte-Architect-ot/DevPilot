# DevPilot Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Database Configuration (Defaults to H2 in-memory DB if DB_URL is not set)
DB_URL=jdbc:mysql://localhost:3307/devpilot?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USER=devpilot
DB_PASSWORD=devpilot
DB_DRIVER=com.mysql.cj.jdbc.Driver

# GitHub OAuth2 App Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OpenAI / AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Application Security & Token Encryption
APP_CRYPTO_PASSWORD=devpilot-secure-crypto-key-change-in-prod
APP_CRYPTO_SALT=12345678

# Web Frontend & CORS
FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
